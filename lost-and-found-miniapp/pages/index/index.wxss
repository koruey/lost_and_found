/* ===== 搜索栏 ===== */
.search-bar {
  padding: var(--spacing-sm) var(--spacing-md);
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input {
  display: flex;
  align-items: center;
  background-color: var(--bg-page);
  border-radius: 9999rpx;
  padding: 14rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: var(--spacing-xs);
}

.search-placeholder {
  flex: 1;
}

/* ===== 公告栏 ===== */
.announce-bar {
  border-bottom: 1rpx solid var(--border-color);
}

.announce-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.announce-swiper {
  height: 40rpx;
}

.announce-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 40rpx;
}

/* ===== Tab 切换 ===== */
.tab-bar {
  display: flex;
  border-bottom: 1rpx solid var(--border-color);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: var(--spacing-md) 0;
  font-size: var(--font-lg);
  color: var(--text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 3rpx;
}

/* ===== 分类横向滚动 ===== */
.category-bar {
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--border-color);
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 0 var(--spacing-md);
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  margin-right: var(--spacing-sm);
  border-radius: 9999rpx;
  background-color: var(--bg-page);
  font-size: var(--font-sm);
  color: var(--text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
}

.category-item.active {
  background-color: #E8F2FF;
  color: var(--primary-color);
  font-weight: 500;
}

/* ===== 列表 ===== */
.item-list {
  height: calc(100vh - 260rpx);
  padding-top: var(--spacing-sm);
}

/* ===== 登录弹窗 ===== */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.login-dialog {
  position: relative;
  width: 640rpx;
  padding: var(--spacing-xl) var(--spacing-lg);
  z-index: 1;
}

.login-icon {
  font-size: 96rpx;
}

.login-title {
  margin-top: var(--spacing-sm);
}

.login-desc {
  line-height: 1.5;
}

.login-actions {
  padding: 0 var(--spacing-sm);
}

.wx-login-btn {
  background-color: #07C160 !important;
  color: #fff !important;
  border-radius: var(--border-radius);
}

.wx-login-btn:active {
  opacity: 0.8;
}

.skip-login {
  cursor: pointer;
}

/* ===== 公告详情弹窗 ===== */
.announce-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
}

.announce-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.announce-dialog {
  position: relative;
  width: 640rpx;
  max-height: 80vh;
  z-index: 1;
  border-radius: 16rpx;
  overflow: hidden;
}

.announce-dialog-header {
  padding: var(--spacing-lg);
  border-bottom: 1rpx solid var(--border-color);
}

.announce-close {
  font-size: 36rpx;
  color: var(--text-hint);
  padding: 4rpx 8rpx;
}

.announce-dialog-body {
  padding: var(--spacing-lg);
  max-height: 60vh;
  overflow-y: auto;
}

.announce-detail-title {
  font-size: var(--font-xl);
  line-height: 1.4;
  margin-bottom: var(--spacing-sm);
}

.announce-detail-time {
  margin-bottom: var(--spacing-lg);
}

.announce-detail-content {
  font-size: var(--font-md);
  line-height: 1.8;
  color: var(--text-primary);
  white-space: pre-wrap;
  word-break: break-all;
}
