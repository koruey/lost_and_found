/* 搜索页样式 */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--border-color);
}

.search-input-box {
  background-color: var(--bg-page);
  border-radius: 9999rpx;
  padding: 10rpx 20rpx;
}

.search-input {
  height: 56rpx;
  font-size: var(--font-md);
}

.clear-btn {
  padding: 0 8rpx;
  font-size: 28rpx;
}

.search-btn {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 56rpx;
}

/* 筛选栏 */
.filter-bar {
  border-bottom: 1rpx solid var(--border-color);
  gap: var(--spacing-sm);
}

.filter-tag {
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  background-color: var(--bg-page);
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.filter-tag.active {
  background-color: #E8F2FF;
  color: var(--primary-color);
}

/* 筛选面板 */
.filter-panel {
  border-bottom: 1rpx solid var(--border-color);
}

.form-item {
  margin-bottom: var(--spacing-sm);
}

.form-input {
  width: 100%;
  height: 64rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--border-radius);
  padding: 0 var(--spacing-sm);
  font-size: var(--font-sm);
  box-sizing: border-box;
}

.picker-value {
  height: 64rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--border-color);
  border-radius: var(--border-radius);
  padding: 0 var(--spacing-sm);
  font-size: var(--font-sm);
}

.filter-actions {
  margin-top: var(--spacing-sm);
  gap: var(--spacing-md);
}

/* 搜索历史 */
.history-tags {
  gap: var(--spacing-sm);
}

.history-tag {
  padding: 10rpx 24rpx;
  background-color: var(--bg-page);
  border-radius: 9999rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 搜索结果 */
.result-count {
  border-bottom: 1rpx solid var(--border-color);
}

.result-list {
  height: calc(100vh - 200rpx);
}
