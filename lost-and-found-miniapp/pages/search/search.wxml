<view class="search-page">
  <!-- 搜索栏 -->
  <view class="search-bar flex items-center bg-white p-16">
    <view class="search-input-box flex-1 flex items-center">
      <text class="search-icon">🔍</text>
      <input
        class="search-input flex-1"
        placeholder="搜索物品名称或描述..."
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
        focus
      />
      <text
        wx:if="{{keyword}}"
        class="clear-btn text-hint"
        bindtap="onClearKeyword"
      >
        ✕
      </text>
    </view>
    <button class="search-btn btn btn-primary btn-sm ml-16" bindtap="onSearch">
      搜索
    </button>
  </view>

  <!-- 筛选条件栏 -->
  <view class="filter-bar flex bg-white px-24 py-8">
    <view class="filter-tag flex items-center" bindtap="toggleFilter">
      <text>📋 筛选</text>
      <text class="ml-4">{{showFilterPanel ? '▲' : '▼'}}</text>
    </view>
    <view class="filter-tag {{sortBy === 'create_time' ? 'active' : ''}}" data-sort="create_time" bindtap="onSortChange">
      最新
    </view>
    <view class="filter-tag {{sortBy === 'view_count' ? 'active' : ''}}" data-sort="view_count" bindtap="onSortChange">
      最热
    </view>
  </view>

  <!-- 筛选面板 -->
  <view wx:if="{{showFilterPanel}}" class="filter-panel bg-white p-24">
    <view class="form-item">
      <text class="form-label text-sm">分类</text>
      <picker mode="selector" range="{{categories}}" range-key="name" bindchange="onCategoryChange">
        <view class="picker-value">{{categoryName || '全部分类'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label text-sm">地点</text>
      <input class="form-input" placeholder="输入地点" value="{{location}}" bindinput="onLocationInput" />
    </view>
    <view class="form-row flex">
      <view class="form-item flex-1 mr-16">
        <text class="form-label text-sm">开始日期</text>
        <picker mode="date" bindchange="onStartDateChange">
          <view class="picker-value">{{startDate || '不限'}}</view>
        </picker>
      </view>
      <view class="form-item flex-1">
        <text class="form-label text-sm">结束日期</text>
        <picker mode="date" bindchange="onEndDateChange">
          <view class="picker-value">{{endDate || '不限'}}</view>
        </picker>
      </view>
    </view>
    <view class="filter-actions flex">
      <button class="btn btn-outline btn-sm flex-1 mr-16" bindtap="onClearFilter">清除筛选</button>
      <button class="btn btn-primary btn-sm flex-1" bindtap="doSearch">确定</button>
    </view>
  </view>

  <!-- 搜索历史（未搜索时） -->
  <view wx:if="{{!searched && searchHistory.length > 0}}" class="history-section p-24">
    <view class="flex-between mb-16">
      <text class="text-bold">搜索历史</text>
      <text class="text-hint text-sm" bindtap="onClearHistory">清除</text>
    </view>
    <view class="history-tags flex flex-wrap">
      <view
        wx:for="{{searchHistory}}"
        wx:key="*this"
        class="history-tag"
        data-keyword="{{item}}"
        bindtap="onHistoryTap"
      >
        {{item}}
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view wx:if="{{searched}}" class="result-section">
    <view wx:if="{{resultList.length > 0}}" class="result-count px-24 py-8 text-hint text-sm">
      共找到 {{resultList.length}} 条结果
    </view>

    <scroll-view
      class="result-list"
      scroll-y
      bindscrolltolower="onLoadMore"
      lower-threshold="100"
    >
      <item-card
        wx:for="{{resultList}}"
        wx:key="id"
        item="{{item}}"
        showType="{{true}}"
      />

      <view wx:if="{{loading && resultList.length > 0}}" class="text-center p-16 text-hint">
        加载中...
      </view>
      <view wx:if="{{!hasMore && resultList.length > 0}}" class="text-center p-16 text-hint">
        — 没有更多了 —
      </view>
    </scroll-view>

    <empty-state
      wx:if="{{!loading && resultList.length === 0}}"
      icon="🔍"
      text="没有找到相关物品"
      actionText="换个关键词试试"
      bind:action="onClearFilter"
    />
  </view>
</view>
