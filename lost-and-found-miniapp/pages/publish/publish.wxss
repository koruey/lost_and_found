/* ===== 类型切换 ===== */
.type-switch {
  border-radius: var(--border-radius);
  gap: var(--spacing-sm);
}

.type-btn {
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--border-radius);
  background-color: var(--bg-page);
  color: var(--text-secondary);
  font-size: var(--font-lg);
  font-weight: 500;
  transition: all 0.2s;
}

.type-btn.active {
  color: #fff;
  font-weight: 600;
}
.type-btn.active.lost { background-color: var(--warning-color); }
.type-btn.active.found { background-color: var(--success-color); }

/* ===== 区块 ===== */
.section {
  border-radius: var(--border-radius);
  margin: 0 var(--spacing-md);
}

.section-title {
  font-size: var(--font-lg);
}

/* ===== AI面板 ===== */
.ai-toggle {
  cursor: pointer;
}

.ai-icon {
  font-size: 36rpx;
}

.ai-panel {
  border-top: 1rpx solid var(--border-color);
  padding-top: var(--spacing-md);
}

.ai-actions {
  display: flex;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
}

.ai-btn {
  flex: 1;
  min-width: 200rpx;
}

.ai-loading {
  padding: 40rpx 0;
  color: var(--primary-color);
  font-size: var(--font-md);
}

.ai-result {
  background-color: var(--bg-page);
  border-radius: var(--border-radius);
  padding: var(--spacing-md);
}

/* ===== 表单 ===== */
.form-item {
  margin-bottom: var(--spacing-lg);
}

.form-label {
  font-size: var(--font-md);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--border-radius);
  padding: 0 var(--spacing-md);
  font-size: var(--font-md);
  box-sizing: border-box;
  background-color: #fff;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--border-radius);
  padding: var(--spacing-md);
  font-size: var(--font-md);
  box-sizing: border-box;
  background-color: #fff;
}

.picker-value {
  height: 80rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--border-color);
  border-radius: var(--border-radius);
  padding: 0 var(--spacing-md);
  font-size: var(--font-md);
}

.char-count {
  margin-top: 4rpx;
}

/* ===== 提交按钮 ===== */
.submit-bar {
  display: flex;
  justify-content: center;
  padding-top: var(--spacing-lg);
}

.submit-bar .btn {
  height: 88rpx;
  font-size: var(--font-lg);
  letter-spacing: 2rpx;
  width: 80%;
}
