/* 物品卡片样式 */
.item-card {
  margin-bottom: 4rpx;
  border: 1rpx solid var(--border-color);
}

.card-layout {
  display: flex;
}

/* 左侧图片 */
.card-image {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--border-radius);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: var(--spacing-md);
  background-color: #f5f5f5;
}

.card-image .image {
  width: 100%;
  height: 100%;
}

.type-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
}

/* 右侧内容 */
.card-body {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: var(--spacing-xs);
}

.info-row {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--spacing-xs);
}

.location {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stats {
  display: flex;
  align-items: center;
}
